# --- Server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Start one with `docker compose up -d` (from the repo root), or with `npx prisma dev` (no Docker needed;
# it prints a URL to paste here).
DATABASE_URL=postgresql://claims:claims@localhost:5432/claims

# --- LLM ---
# "openai" calls the real API. "fake" runs everything offline with no key (for demos and tests only).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any model that supports Structured Outputs. Kept in config on purpose: models get retired.
OPENAI_MODEL=gpt-4.1-mini
# Delete this line for models that reject a temperature setting (for example reasoning models).
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_MS=60000
